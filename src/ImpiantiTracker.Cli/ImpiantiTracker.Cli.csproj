<Project Sdk="Microsoft.NET.Sdk">

  <!-- The command-line app: reads settings, parses arguments, prints tables. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ImpiantiTracker.Cli</RootNamespace>
    <AssemblyName>impianti</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImpiantiTracker.Data\ImpiantiTracker.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <!-- Needed only by the "dotnet ef" migration tools; not shipped with the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
